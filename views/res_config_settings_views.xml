<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.alarm.ukraine</field>
        <field name="model">res.config.settings</field>
        <!-- Наследуем стандартную вьюшку настроек Odoo -->
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Ищем блок Общих настроек (app=general_settings) -->
            <xpath expr="//form//app[@name='general_settings']" position="inside">

                <!-- Создаем красивый блок нашей интеграции -->
                <block title="Інтеграція із Сиренами України" string="Повітряна Тривога" id="alarm_ukraine_setting_block">
                    <setting string="Налаштування API" help="Вкажіть токен доступу для стабільної роботи модуля">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="alarm_ua_api_token" class="col-lg-3 o_light_label"/>
                                <!-- Само поле ввода -->
                                <field name="alarm_ua_api_token" password="True"/>
                                <!-- password="True" скроет токен звездочками (******) для безопасности -->
                            </div>
                        </div>
                    </setting>
                </block>

            </xpath>
        </field>
    </record>
</odoo>
